{
  "name": "rennet",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first code review harness",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.32.1"
  },
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "affected": "nx affected -t lint,typecheck,test,build",
    "check": "nx run-many -t check --projects=rennet-prototype,event-store-publish-failure",
    "check:affected": "nx affected -t check",
    "check:event-store": "nx run event-store-publish-failure:check",
    "check:prototype": "nx run rennet-prototype:check",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@nx/workspace": "23.1.0",
    "nx": "23.1.0"
  }
}
