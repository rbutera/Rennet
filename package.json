{
  "name": "rennet",
  "version": "0.3.39",
  "private": true,
  "description": "A local-first code review harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbutera/rennet.git"
  },
  "license": "LicenseRef-FSL-1.1-MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.32.1"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "architecture": {
        "cache": true,
        "command": "node scripts/check-boundaries.mjs",
        "inputs": [
          "{workspaceRoot}/packages/**/package.json",
          "{workspaceRoot}/packages/**/project.json",
          "{workspaceRoot}/packages/**/src/**/*",
          "{workspaceRoot}/apps/**/package.json",
          "{workspaceRoot}/apps/**/project.json",
          "{workspaceRoot}/apps/**/src/**/*",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/scripts/check-boundaries.mjs",
          "{workspaceRoot}/scripts/pnpm-launcher.mjs",
          "sharedGlobals"
        ]
      },
      "audit": {
        "cache": false,
        "command": "pnpm audit --audit-level high"
      },
      "format": {
        "cache": true,
        "command": "pnpm exec biome check packages/*/src apps/desktop/src apps/desktop/e2e apps/desktop/*.ts apps/desktop/*.cjs apps/desktop/*.json apps/mobile/src apps/mobile/app apps/mobile/*.ts apps/mobile/*.js apps/mobile/app.json apps/mobile/package.json apps/mobile/tsconfig.json apps/mobile/project.json apps/marketing/astro.config.mjs apps/marketing/project.json apps/marketing/package.json apps/marketing/src/styles apps/docs/astro.config.mjs apps/docs/project.json apps/docs/package.json apps/docs/tsconfig.json apps/docs/src/content.config.ts apps/docs/src/plugins apps/docs/src/styles docs/project.json scripts/*.mjs package.json biome.json",
        "inputs": [
          "{workspaceRoot}/packages/*/src/**/*",
          "{workspaceRoot}/apps/desktop/src/**/*",
          "{workspaceRoot}/apps/desktop/e2e/**/*",
          "{workspaceRoot}/apps/desktop/*.ts",
          "{workspaceRoot}/apps/desktop/*.cjs",
          "{workspaceRoot}/apps/desktop/*.json",
          "{workspaceRoot}/apps/mobile/src/**/*",
          "{workspaceRoot}/apps/mobile/app/**/*",
          "{workspaceRoot}/apps/mobile/*.ts",
          "{workspaceRoot}/apps/mobile/*.js",
          "{workspaceRoot}/apps/mobile/*.json",
          "{workspaceRoot}/apps/marketing/**/*",
          "{workspaceRoot}/apps/docs/astro.config.mjs",
          "{workspaceRoot}/apps/docs/project.json",
          "{workspaceRoot}/apps/docs/package.json",
          "{workspaceRoot}/apps/docs/tsconfig.json",
          "{workspaceRoot}/apps/docs/src/content.config.ts",
          "{workspaceRoot}/apps/docs/src/plugins/**/*",
          "{workspaceRoot}/apps/docs/src/styles/**/*",
          "{workspaceRoot}/docs/project.json",
          "{workspaceRoot}/scripts/*.mjs",
          "sharedGlobals"
        ]
      },
      "licenses": {
        "cache": true,
        "command": "node scripts/check-licenses.mjs",
        "inputs": [
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/packages/**/package.json",
          "{workspaceRoot}/apps/**/package.json",
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/scripts/check-licenses.mjs",
          "{workspaceRoot}/scripts/pnpm-launcher.mjs",
          "sharedGlobals"
        ]
      }
    }
  },
  "scripts": {
    "affected": "nx affected -t lint,typecheck,test,build",
    "architecture": "nx run rennet:architecture",
    "audit": "nx run rennet:audit",
    "build": "nx run-many -t build",
    "check": "nx run-many -t format,architecture,licenses,lint,typecheck,test,build",
    "check:affected": "nx affected -t lint,typecheck,test,build",
    "check:event-store": "nx run event-store-publish-failure:check",
    "dev": "nx run rennet-desktop:dev",
    "e2e": "nx run rennet-desktop:e2e",
    "graph": "nx graph",
    "notices": "node scripts/generate-notices.mjs",
    "rennet": "node packages/server/dist/rennet.cjs",
    "real-turn": "nx run rennet-adapters:real-turn",
    "release:check": "node scripts/check-release.mjs",
    "release:env": "scripts/with-release-env.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@electron/node-gyp": "git+https://github.com/electron/node-gyp.git#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.7.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@octokit/core": "7.0.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
