{
  "type": "object",
  "properties": {
    "path": {
      "type": "object",
      "properties": {
        "repoKey": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string"
        }
      },
      "required": [
        "repoKey",
        "displayName"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "workspace",
        "repo"
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "object",
            "properties": {
              "repoKey": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "relativePath": {
                "type": "string"
              }
            },
            "required": [
              "repoKey",
              "displayName"
            ],
            "additionalProperties": false
          },
          "branches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "remote": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "branches"
        ],
        "additionalProperties": false
      }
    },
    "primaryBranch": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation": {
      "type": "string"
    },
    "source": {
      "default": "local",
      "anyOf": [
        {
          "type": "string",
          "const": "local"
        },
        {
          "type": "string",
          "pattern": "^wsl:.+$"
        },
        {
          "type": "string",
          "pattern": "^remote:.+$"
        }
      ]
    }
  },
  "required": [
    "path",
    "kind",
    "repos",
    "primaryBranch",
    "source"
  ],
  "additionalProperties": false
}
