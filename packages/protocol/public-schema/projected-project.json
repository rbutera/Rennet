{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "object",
      "properties": {
        "repoKey": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string"
        }
      },
      "required": [
        "repoKey",
        "displayName"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "workspace",
        "repo"
      ]
    },
    "repoCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "branchCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "primaryBranch": {
      "type": "string",
      "minLength": 1
    },
    "openPath": {
      "type": "object",
      "properties": {
        "repoKey": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "type": "string"
        }
      },
      "required": [
        "repoKey",
        "displayName"
      ],
      "additionalProperties": false
    },
    "includedRepoPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repoKey": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "relativePath": {
            "type": "string"
          }
        },
        "required": [
          "repoKey",
          "displayName"
        ],
        "additionalProperties": false
      }
    },
    "addedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "name",
    "path",
    "kind",
    "repoCount",
    "branchCount",
    "primaryBranch",
    "openPath",
    "addedAt"
  ],
  "additionalProperties": false
}
