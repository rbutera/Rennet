{
  "name": "rennet-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/server/src",
  "projectType": "library",
  "tags": ["scope:rennet", "layer:server"],
  "namedInputs": {
    "serverCliBuildScripts": [
      "{workspaceRoot}/scripts/build-server-cli.mjs",
      "{workspaceRoot}/scripts/native-artifact-staging.mjs",
      "{workspaceRoot}/scripts/native-artifact-staging.d.mts"
    ],
    "nativeArtifactStagingTest": [
      "{workspaceRoot}/scripts/native-artifact-staging.mjs",
      "{workspaceRoot}/scripts/native-artifact-staging.test.mjs"
    ]
  },
  "targets": {
    "build": {
      "command": "pnpm exec tsc -p packages/server/tsconfig.json && node scripts/build-server-cli.mjs",
      "inputs": ["default", "^production", { "input": "serverCliBuildScripts" }],
      "outputs": ["{projectRoot}/dist"],
      "cache": false
    },
    "lint": {
      "command": "pnpm exec eslint packages/server/src --max-warnings=0 && pnpm exec biome check packages/server/src"
    },
    "typecheck": { "command": "pnpm exec tsc -p packages/server/tsconfig.json" },
    "test": {
      "command": "pnpm exec vitest run packages/server/src && node --test scripts/native-artifact-staging.test.mjs",
      "dependsOn": ["build"],
      "inputs": ["default", "^production", { "input": "nativeArtifactStagingTest" }]
    },
    "real-knowledge": {
      "cache": false,
      "command": "RENNET_C22_PROOF=1 pnpm exec vitest run packages/server/integration"
    }
  }
}
