{
  "name": "rennet-lens-instructions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/lens-instructions/src",
  "projectType": "library",
  "tags": ["scope:rennet", "layer:lens-instructions"],
  "targets": {
    "build": { "command": "pnpm exec tsc -p packages/lens-instructions/tsconfig.json" },
    "lint": {
      "command": "pnpm exec eslint packages/lens-instructions/src --max-warnings=0 && pnpm exec biome check packages/lens-instructions/src"
    },
    "typecheck": { "command": "pnpm exec tsc -p packages/lens-instructions/tsconfig.json" },
    "test": { "command": "pnpm exec vitest run packages/lens-instructions/src" }
  }
}
