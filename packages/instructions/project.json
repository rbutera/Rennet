{
  "name": "rennet-instructions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/instructions/src",
  "projectType": "library",
  "tags": ["scope:rennet", "layer:instructions"],
  "targets": {
    "build": { "command": "pnpm exec tsc -p packages/instructions/tsconfig.json" },
    "lint": { "command": "pnpm exec eslint packages/instructions/src --max-warnings=0 && pnpm exec biome check packages/instructions/src" },
    "typecheck": { "command": "pnpm exec tsc -p packages/instructions/tsconfig.json" },
    "test": { "command": "pnpm exec vitest run packages/instructions/src" }
  }
}
