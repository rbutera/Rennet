{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/.tool-versions",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint-suppressions.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/vitest.config.ts"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/test/**",
      "!{projectRoot}/tests/**"
    ],
    "t3codeShared": [
      "{workspaceRoot}/vendor/t3code/package.json",
      "{workspaceRoot}/vendor/t3code/tsconfig.base.json",
      "{workspaceRoot}/vendor/t3code/vite.config.ts",
      "{workspaceRoot}/vendor/t3code/scripts/lib/**/*",
      "{workspaceRoot}/vendor/t3code/patches/**/*",
      "{workspaceRoot}/vendor/t3code/UPSTREAM.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/out"]
    },
    "check": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/coverage"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    },
    "e2e": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"]
    }
  },
  "plugins": []
}
