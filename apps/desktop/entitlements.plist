<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Hardened-runtime entitlements for the notarized build. Electron's V8 needs
      JIT and writable/executable memory; disable-library-validation lets the app
      load the Electron frameworks and spawn the user's own installed `claude`
      binary. These are the standard entitlements every notarized Electron app
      ships. They are only applied when signing with a real Developer ID identity
      (APPLE_SIGNING_IDENTITY); the default ad-hoc build does not use the hardened
      runtime and so does not read this file.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
