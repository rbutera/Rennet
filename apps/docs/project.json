{
  "name": "rennet-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "tags": ["scope:rennet", "layer:app", "platform:docs"],
  "targets": {
    "build": {
      "command": "pnpm --dir apps/docs exec astro build"
    },
    "dev": {
      "cache": false,
      "command": "pnpm --dir apps/docs exec astro dev"
    },
    "preview": {
      "cache": false,
      "command": "pnpm --dir apps/docs exec astro preview"
    }
  }
}
