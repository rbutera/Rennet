{
  "expo": {
    "name": "Rennet",
    "slug": "rennet",
    "scheme": "rennet",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false },
    "android": {
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Rennet scans the pairing QR your desktop shows." }],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": false }
  }
}
