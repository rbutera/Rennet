<script>
import { mountExperience } from "../animation/experience";
mountExperience();
const toggle = document.querySelector<HTMLButtonElement>(".scheme-toggle");
const applyReadingTheme = (light: boolean) => {
 document.documentElement.dataset.reading = light ? "light" : "dark";
 toggle?.setAttribute("aria-label", light ? "Use dark reading panels" : "Use light reading panels");
 toggle?.setAttribute("aria-pressed", String(light));
 document.querySelectorAll<HTMLImageElement>("img[data-light-src]").forEach(image => {
 const source = light ? image.dataset.lightSrc : image.dataset.darkSrc;
 if (source) image.src = source;
 });
};
try { applyReadingTheme(localStorage.getItem("rennet-marketing-reading") === "light"); } catch { applyReadingTheme(false); }
toggle?.addEventListener("click", () => {
 const light = document.documentElement.dataset.reading !== "light";
 applyReadingTheme(light);
 try { localStorage.setItem("rennet-marketing-reading", light ? "light" : "dark"); } catch { /* The current page still changes when storage is unavailable. */ }
});
document.querySelectorAll<HTMLDetailsElement>(".lens-detail").forEach(detail => {
 detail.addEventListener("toggle", () => { if(detail.open && document.activeElement === detail.querySelector("summary")) detail.scrollIntoView({block:"start",behavior:"smooth"}); });
});
const openAnchor = () => {
 const id = decodeURIComponent(location.hash.slice(1));
 const target = document.getElementById(id);
 if (target instanceof HTMLDetailsElement) { target.open = true; requestAnimationFrame(() => target.scrollIntoView()); }
};
window.addEventListener("hashchange",openAnchor);openAnchor();
</script></body></html>
