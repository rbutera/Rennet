---
import "@fontsource-variable/instrument-sans/wdth.css";
import "@fontsource-variable/source-sans-3/wght.css";
import logoWhite from "../../../../brand/exports/logo/svg/lockup-horizontal-white.svg?url";
import markWhite from "../../../../brand/exports/logo/svg/mark-small-white.svg?url";
import CategoryStatement from "../components/CategoryStatement.astro";
import "../styles/global.css";

const githubUrl = "https://github.com/rbutera/rennet";
const downloadUrl = `${githubUrl}/releases/latest`;

const diffLines = [
  ["+", 82, "add"],
  ["+", 58, "add"],
  [" ", 91, "plain"],
  ["-", 64, "remove"],
  ["+", 76, "add"],
  [" ", 48, "plain"],
  ["+", 68, "add"],
  ["-", 54, "remove"],
  [" ", 87, "plain"],
];

const lenses = [
  ["Spec", "Read the change against what it promised."],
  ["Sequence", "Follow the implementation in dependency order."],
  ["Decisions", "See the judgments hidden inside the patch."],
  ["Flagged", "Resolve findings, verification, and model disagreement."],
  ["Noise", "Keep generated churn out of the reading path."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Rennet is a free, local-first macOS review harness for understanding, questioning, and refining large AI-generated code changes."
    />
    <meta id="theme-color" name="theme-color" content="#f4f2ed" />
    <meta property="og:title" content="Rennet — Make code digestible" />
    <meta
      property="og:description"
      content="You stopped writing the code. You still have to answer for it."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rennet.dev" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://rennet.dev" />
    <title>Rennet — Make code digestible</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("rennet-scheme");
        const scheme = saved === "light" || saved === "dark"
          ? saved
          : matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.scheme = scheme;
        document.querySelector("#theme-color")?.setAttribute(
          "content",
          scheme === "dark" ? "#0e1116" : "#f4f2ed",
        );
      })();
    </script>
  </head>
  <body>
    <!--
      THESIS: AI expanded the diff faster than the human context window; Rennet restores accountable judgment without hiding the code.
      OWN-WORLD: editorial light and dark fields, precise rules, neo-grotesk display type, calm reading type, and product-native evidence.
      STORY: feel the review bottleneck, choose your workflow, see digestion and conversation, then understand the harness and repo intelligence.
      FIRST VIEWPORT: the fixed accountability headline faces a compact review sequence; the download action remains immediate.
      FORM: established-world narrative rebuild; no concept seed because this extends the approved Breaking Edge identity.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="brand" href="#top" aria-label="Rennet home">
        <img class="logo-light" src="/brand/rennet-lockup.svg" alt="Rennet" width="160" height="46" />
        <img class="logo-dark" src={logoWhite} alt="Rennet" width="160" height="46" />
      </a>
      <nav aria-label="Primary navigation">
        <a href="#workflows">Workflows</a>
        <a href="https://docs.rennet.dev">Docs</a>
        <a href={githubUrl}>GitHub</a>
        <a class="button nav-download" href={downloadUrl} aria-label="Download Rennet for macOS">Download</a>
        <button class="scheme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
          <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path></svg>
          <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.4A8.5 8.5 0 0 1 8.6 3.6 8.5 8.5 0 1 0 20.4 15.4Z"></path></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <section class="hero shell" id="top">
        <div class="hero-copy">
          <h1>You stopped writing the code.<br />You still have to answer for it.</h1>
          <p class="hero-deck">
            Rennet turns large changes into a review you can understand, question, refine, and
            stand behind.
          </p>
          <p class="agentic-line">Not for vibe coders. For agentic engineers.</p>
          <div class="hero-actions">
            <a class="button primary" href={downloadUrl}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 17v3h14v-3"></path></svg>
              Download for macOS
            </a>
            <a class="text-link" href={githubUrl}>View on GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <p class="availability">Available now · Free · Open source · MIT</p>
        </div>

        <figure class="digest" aria-labelledby="digest-caption">
          <ol class="digest-stages">
            <li class="digest-stage raw-stage">
              <div class="stage-label"><span>Raw change</span><strong>1,872 lines</strong></div>
              <div class="diff-mass" aria-hidden="true">
                <div class="diff-head"><span>atlas · feat/rate-limiting</span><span>+1,291 −581</span></div>
                <div class="diff-body">
                  {diffLines.map(([sign, width, tone]) => (
                    <div class:list={["diff-line", tone]} style={`--line:${width}%`}><span>{sign}</span><i></i></div>
                  ))}
                </div>
              </div>
            </li>
            <li class="digest-stage cohort-stage">
              <div class="stage-label"><span>Related cohorts</span><strong>4 parts</strong></div>
              <div class="cohort-list" aria-hidden="true">
                <div><i class="blue"></i><span>Storage & state</span><b>4</b></div>
                <div><i class="amber"></i><span>Failure posture</span><b>3</b></div>
                <div><i class="green"></i><span>Interface & API</span><b>2</b></div>
                <p>+ tests & noise</p>
              </div>
            </li>
            <li class="digest-stage decision-stage">
              <div class="stage-label"><span>Human decisions</span><strong>11 calls</strong></div>
              <div class="decision-list" aria-hidden="true">
                <div><span>1</span><p>One refill-on-read bucket</p></div>
                <div><span>2</span><p>Fail open on store error</p></div>
                <div><span>3</span><p>Keep Redis out of core</p></div>
              </div>
            </li>
            <li class="digest-stage paper-stage">
              <div class="stage-label"><span>Your review</span><strong>One paper</strong></div>
              <div class="paper" aria-hidden="true">
                <div><span>Review · #482</span><b>Ready</b></div>
                <h2>Exactly what will post.</h2>
                <i></i><i></i>
                <ul><li><b>3</b> request changes</li><li><b>1</b> comment</li></ul>
              </div>
            </li>
          </ol>
          <figcaption id="digest-caption">From raw change to accountable judgment. Illustrative review data.</figcaption>
        </figure>
      </section>

      <section class="pressure section shell">
        <h2>AI can produce more code than a human can hold in their head.</h2>
        <div>
          <p>
            Pull requests have ballooned. The old file-by-file reading ritual now asks the human
            context window to keep pace with machines that never get tired.
          </p>
          <p>
            Rennet does the structural reading work: grouping, ordering, narrating, and surfacing
            decisions. You still read the code. Your attention goes where engineering judgment is
            actually required.
          </p>
        </div>
      </section>

      <CategoryStatement />

      <section class="workflows section shell" id="workflows">
        <div class="section-heading">
          <h2>Two sides of the same responsibility.</h2>
          <p>Whether the code is yours or a teammate’s, the job is to understand what carries your name.</p>
        </div>
        <div class="workflow-pair">
          <article class="workflow own-work">
            <div class="workflow-title"><span>Before you submit</span><h3>Your own work</h3></div>
            <p>
              Your coding agent finished the branch. Before you open the PR, Rennet helps you
              understand the change, catch issues, refine the implementation, and fulfil the human
              review work the agent cannot own for you.
            </p>
            <ol>
              <li><span>Branch</span><p>Review committed and working-tree changes.</p></li>
              <li><span>Refine</span><p>Turn your dispositions into focused work for the coding harness.</p></li>
              <li><span>Re-read</span><p>Rennet captures the result as a new patchset and re-reviews only what changed.</p></li>
            </ol>
          </article>
          <article class="workflow team-work">
            <div class="workflow-title"><span>When they submit</span><h3>Someone else’s work</h3></div>
            <p>
              A teammate sends an agent-driven PR. Rennet walks you through it in comprehension
              order, keeps the real code under your hands, and turns your decisions into one normal
              GitHub review in your own voice.
            </p>
            <ol>
              <li><span>Pull request</span><p>Read the promise, structure, and changed code together.</p></li>
              <li><span>Question</span><p>Interrogate any finding, decision, or line.</p></li>
              <li><span>Review</span><p>Edit and sign the exact paper GitHub receives.</p></li>
            </ol>
          </article>
        </div>
      </section>

      <section class="conversation section shell">
        <div class="conversation-copy">
          <h2>Don’t just read the diff. Talk to it.</h2>
          <p>
            Ask what changed, why it changed, how it fits the surrounding repository, or whether a
            failure path is intentional. The conversation stays attached to the review and its code.
          </p>
        </div>
        <div class="conversation-proof" aria-label="Illustrative conversation with a code change">
          <div class="code-question">
            <div class="code-bar"><span>src/rate-limit/store.ts</span><span>lines 84–101</span></div>
            <code><span class="minus">− return store.get(key)</span><span class="plus">+ return store.get(key).catch(() =&gt; fallback)</span></code>
          </div>
          <div class="thread">
            <div class="question"><span>You</span><p>Why does this fail open instead of blocking the request?</p></div>
            <div class="answer"><span>Claude Code</span><p>The PR treats rate limiting as protective infrastructure, not an availability dependency. The fallback preserves service when the store is unavailable.</p></div>
          </div>
        </div>
      </section>

      <section class="harnesses section shell">
        <div class="section-heading harness-heading">
          <h2>Your Claude Code. Your Codex. Already connected.</h2>
          <p>
            Rennet detects the coding harnesses installed on your Mac and uses their existing
            authentication. No new API keys and no Rennet inference markup.
          </p>
        </div>
        <div class="provider-lockups" aria-label="Supported coding harnesses">
          <div class="provider">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"></path></svg>
            <div><strong>Claude Code</strong><span>Existing install · existing account</span></div>
          </div>
          <span class="provider-plus" aria-hidden="true">+</span>
          <div class="provider">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z"></path></svg>
            <div><strong>Codex</strong><span>Existing install · existing account</span></div>
          </div>
        </div>
        <div class="dual-review">
          <div class="dual-copy"><h3>Two independent reads.<br />Disagreement is where you look.</h3><p>Claude and Codex review the same evidence independently. Rennet shows where they agree and, more importantly, where they split. Nothing is averaged into false consensus.</p></div>
          <div class="dual-proof" aria-label="Two model reviews disagreeing on one finding">
            <div><span>Claude</span><p>Fallback masks a real storage outage.</p><b>Request change</b></div>
            <div><span>Codex</span><p>Availability policy supports this fallback.</p><b>Accept with note</b></div>
            <p><i></i> Models disagree · human judgment required</p>
            <small>Illustrative dual-review output</small>
          </div>
        </div>
      </section>

      <section class="intelligence section shell">
        <div class="intelligence-copy">
          <h2>A repo map that grows with the repo.</h2>
          <p>
            Rennet combines deterministic discovery with evidence-backed model knowledge. It maps
            files, workspaces, symbols, references, tests, ownership, and dependencies, then uses a
            model to enrich what that structure means.
          </p>
          <p>
            When the reference branch advances, affected structure is rebuilt and the knowledge
            delta is refreshed. The reviewer starts with the repository’s current shape, not a
            stale snapshot of what it used to be.
          </p>
        </div>
        <div class="map-proof" aria-label="Repository intelligence layers">
          <div class="map-root"><strong>atlas/</strong><span>current · main@8d2f1a</span></div>
          <div class="map-layer deterministic"><span>Deterministic discovery</span><b>47 workspaces · 3,284 symbols · 612 test links</b></div>
          <div class="map-layer learned"><span>Evidence-backed knowledge</span><b>9 conventions · 4 boundaries · 3 active decisions</b></div>
          <div class="map-update"><i></i><p><strong>Reference branch advanced</strong><span>12 affected shards rebuilt · knowledge delta refreshed</span></p></div>
          <small>Illustrative repository data</small>
        </div>
      </section>

      <section class="product section shell">
        <div class="section-heading">
          <h2>The code never disappears.</h2>
          <p>Move from overview to evidence without losing your place. Rennet changes the reading order, not the need to read.</p>
        </div>
        <figure class="product-frame">
          <div class="window-bar"><span class="traffic"><i></i><i></i><i></i></span><span>atlas · feat/rate-limiting</span><span>patchset 8</span></div>
          <img src="/product/review-heart.png" alt="Rennet review surface with ordered changes, code, and an attached conversation" width="1536" height="1024" loading="lazy" />
          <figcaption>Current product wireframe</figcaption>
        </figure>
      </section>

      <section class="shells section shell">
        <div class="section-heading">
          <h2>One app. A window or a tab. Any of your machines.</h2>
          <p>Run Rennet as the desktop app or open it as a browser tab the daemon serves itself — both are the full product, no read-only mode, no feature in only one. Review from another computer or your phone by pairing it to your daemon over Tailscale. There is still no hosted anything: the remote device talks straight to your machine, and it never sees a path on it.</p>
        </div>
      </section>

      <section class="lenses section shell">
        <div><h2>Five angles.<br />One complete review.</h2><p>Change altitude without losing the decision or its evidence.</p></div>
        <ol>
          {lenses.map(([name, description]) => <li><h3>{name}</h3><p>{description}</p></li>)}
        </ol>
      </section>

      <section class="truth section shell">
        <div><h2>Local-first, without pretending the models are local.</h2><p>Rennet has no backend and no telemetry. Selected harnesses may send assembled context to their own providers under their existing accounts. Rennet tells you that plainly.</p></div>
        <dl><div><dt>Rennet backend</dt><dd>None</dd></div><div><dt>Telemetry</dt><dd>None</dd></div><div><dt>API key setup</dt><dd>None</dd></div><div><dt>Supported at launch</dt><dd>macOS</dd></div><div><dt>Licence</dt><dd>MIT</dd></div></dl>
      </section>

      <section class="objections section shell">
        <h2>The questions worth asking.</h2>
        <div>
          <details open><summary>Is this another autonomous review bot?</summary><p>No. Rennet performs the structural reading work. You inspect, question, edit, and sign the judgment another person sees.</p></details>
          <details><summary>Does dual review mean a model decides by majority?</summary><p>No. Claude and Codex run independently. Agreement is evidence; disagreement is a signal for you, never something Rennet averages away.</p></details>
          <details><summary>Does “local-first” mean nothing leaves my machine?</summary><p>Rennet itself has no backend or telemetry. The coding harness you select still talks to its provider under its own terms and authentication.</p></details>
        </div>
      </section>

      <section class="closing">
        <div class="shell closing-inner">
          <img class="closing-mark-light" src="/brand/rennet-mark-small.svg" alt="" width="72" height="54" />
          <img class="closing-mark-dark" src={markWhite} alt="" width="72" height="54" />
          <p class="closing-theme">Not for avoiding the code.<br />For engineers accountable for it.</p>
          <h2>Make the next change digestible.</h2>
          <div class="hero-actions"><a class="button primary inverse" href={downloadUrl}>Download for macOS</a><a class="text-link inverse-link" href={githubUrl}>View on GitHub <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </main>

    <footer class="site-footer shell">
      <a class="brand" href="#top" aria-label="Rennet home"><img class="logo-light" src="/brand/rennet-lockup.svg" alt="Rennet" width="136" height="40" /><img class="logo-dark" src={logoWhite} alt="Rennet" width="136" height="40" /></a>
      <div class="footer-copy">
        <p>Rennet turns a body of code into pieces a person can digest, question, and answer for.</p>
        <p class="footer-meaning">Rennet is the enzyme that separates milk into curds and whey. It adds nothing; it separates what is already there.</p>
      </div>
      <nav aria-label="Footer navigation"><a href="https://docs.rennet.dev">Docs</a><a href={githubUrl}>GitHub</a><a href={`${githubUrl}/blob/main/LICENSE`}>MIT licence</a></nav>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector(".scheme-toggle");
      const updateToggle = () => {
        const dark = root.dataset.scheme === "dark";
        toggle?.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} theme`);
        toggle?.setAttribute("aria-pressed", String(dark));
        document.querySelector("#theme-color")?.setAttribute(
          "content",
          dark ? "#0e1116" : "#f4f2ed",
        );
      };
      updateToggle();
      toggle?.addEventListener("click", () => {
        root.dataset.scheme = root.dataset.scheme === "dark" ? "light" : "dark";
        localStorage.setItem("rennet-scheme", root.dataset.scheme);
        updateToggle();
      });
    </script>
  </body>
</html>
