---
// Product captures stay sharp and opaque above the animated marketing scene.
interface Props {
  name: string;
  alt: string;
  label: string;
  caption?: string;
}

const { name, alt, label, caption = "A fixture branch reviewed in the shipped app" } = Astro.props;
---

<figure class="product-frame">
  <div class="window-bar"><span class="traffic"><i></i><i></i><i></i></span><span>atlas · feat/rate-limiting</span><span>{label}</span></div>
  <img src={`/product/${name}-dark.png`} data-light-src={`/product/${name}-light.png`} data-dark-src={`/product/${name}-dark.png`} alt={alt} width="1536" height="1024" loading="lazy" decoding="async" />
  <figcaption>{caption}</figcaption>
</figure>
