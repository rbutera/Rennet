# Operating system and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Dependencies
node_modules/
.pnpm-store/

# Build and package outputs
.vite-plus/
dist/
build/
out/
release/
.vite/
.nx/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Runtime state and local project context
.rennet/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.log
logs/

# Secrets and local configuration
.private/
.env
.env.*
!.env.example
!.env.release.example

# Temporary files
.cache/
.tmp/
tmp/
*.tmp

.claude/worktrees
.claude/settings.local.json

# openspec: the user's global ~/.gitignore ignores openspec/ repo-wide.
# Un-ignore it here so openspec changes track normally (no more `git add -f`).
!openspec/
!openspec/**

# superpowers working artifacts (plans, worktrees) are not canonical docs
docs/superpowers/
.playwright-mcp/
# The global ~/.gitignore ignores .claude entirely; re-expose only the vendored
# skills so hooks (lint-staged git add) can stage them without -f.
!.claude/
.claude/*
!.claude/skills/
